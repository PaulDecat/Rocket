# Copiez ce fichier en « .env » (même dossier) pour activer des options. Tout est facultatif.

# Port de l'application (par défaut 3000)
# PORT=3000

# --- Claude ---
# Rocket utilise en priorité Claude Code installé sur l'ordinateur (votre abonnement, sans frais en plus).
# Sinon, avec une clé API Anthropic, Rocket utilise l'API (facturée à l'usage) :
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-5-5
# Forcer un mode : claude-code | api | local
# ASSISTANT=api

# Rapidité (Claude Code et API) : modèle et niveau de réflexion.
# Par défaut : modèle « sonnet » et réflexion « low » (rapide, idéal à la voix).
# Plus réfléchi mais plus lent : ROCKET_CLAUDE_MODEL=opus et ROCKET_CLAUDE_EFFORT=medium
# ROCKET_CLAUDE_MODEL=sonnet
# ROCKET_CLAUDE_EFFORT=low

# --- Voix ---
# Par défaut : voix neuronales Microsoft gratuites (via le serveur).
# Forcer les voix du navigateur :
# TTS_PROVIDER=browser
# Option payante ElevenLabs (les deux lignes sont nécessaires) :
# ELEVENLABS_API_KEY=...
# ELEVENLABS_VOICE=identifiant-de-la-voix-de-Rocket

# Autoriser les questions à Nova depuis d'autres appareils du Wi-Fi (automatique sur Render).
# Attention : avec une clé API, chaque question est facturée.
# ALLOW_REMOTE_ASK=1

# Simuler une coupure réseau (mode démo) :
# ROCKET_OFFLINE=1
